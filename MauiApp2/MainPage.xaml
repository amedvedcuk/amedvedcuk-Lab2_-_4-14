<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:MauiApp2.Models"
             xmlns:viewmodels="clr-namespace:MauiApp2.ViewModels"
             x:Class="MauiApp2.MainPage"
             x:DataType="viewmodels:StudentViewModel"
             Title="Особистий кабінет студента">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">

            <Label Text="{Binding SummaryText}"
                   FontSize="16"
                   FontAttributes="Bold" />

            <Entry Placeholder="ПІБ студента"
                   Text="{Binding FullName, Mode=TwoWay}" />

            <Entry Placeholder="Група"
                   Text="{Binding Group, Mode=TwoWay}" />

            <Entry Placeholder="Середній бал (0–5)"
                   Keyboard="Numeric"
                   Text="{Binding AverageScore, Mode=TwoWay}" />

            <Slider Minimum="0"
                    Maximum="5"
                    Value="{Binding AverageScore, Mode=TwoWay}" />

            <Label Text="{Binding AverageScore, StringFormat='Бал: {0:F2}'}"
                   TextColor="{Binding ScoreIndicatorColor}"
                   FontAttributes="Bold" />

            <Button Text="Додати студента"
                    Command="{Binding AddStudentCommand}" />

            <CollectionView ItemsSource="{Binding Students}"
                            SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Student">
                        <Border Padding="12"
                                Margin="0,4">
                            <Grid ColumnDefinitions="*,Auto"
                                  ColumnSpacing="10">
                                <VerticalStackLayout Grid.Column="0"
                                                     Spacing="2">
                                    <Label Text="{Binding FullName}"
                                           FontAttributes="Bold" />
                                    <Label Text="{Binding Group, StringFormat='Група: {0}'}" />
                                    <Label Text="{Binding AverageScore, StringFormat='Бал: {0:F2}'}" />
                                </VerticalStackLayout>

                                <Button Grid.Column="1"
                                        Text="Деталі"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenDetailsCommand}"
                                        CommandParameter="{Binding .}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>